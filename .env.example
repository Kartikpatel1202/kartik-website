# Absolute origin of the deployed site, used at build time for canonical URLs, the sitemap,
# robots.txt, Open Graph URLs and JSON-LD. No trailing slash. Defaults to http://localhost:3000.
SITE_URL=https://example.com

# Optional. The contact form already emails messages through FormSubmit with no key. To use
# Web3Forms instead, create a key at https://web3forms.com for the receiving inbox, put it in
# .env.local (never in this file) and rebuild.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
